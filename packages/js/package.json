{
  "name": "@axistaylor/nextpress",
  "version": "1.5.4",
  "description": "Render WordPress Gutenberg content 1:1 in Next.js. Automatic script/stylesheet loading, middleware proxy, and multi-WordPress support.",
  "keywords": [
    "wordpress",
    "wpgraphql",
    "nextjs",
    "headless",
    "gutenberg",
    "woocommerce",
    "react"
  ],
  "homepage": "https://github.com/AxisTaylor/nextpress",
  "bugs": {
    "url": "https://github.com/AxisTaylor/nextpress/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./withWCR": {
      "import": "./dist/esm/withWCR.mjs",
      "require": "./dist/cjs/withWCR.cjs",
      "types": "./dist/types/withWCR.d.ts"
    },
    "./proxyByWCR": {
      "import": "./dist/esm/proxyByWCR.mjs",
      "require": "./dist/cjs/proxyByWCR.cjs",
      "types": "./dist/types/proxyByWCR.d.ts"
    },
    "./client": {
      "import": "./dist/esm/client.mjs",
      "require": "./dist/cjs/client.cjs",
      "types": "./dist/types/client.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "html-react-parser": "^5.2.17"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "next": ">=14.2.5",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "build:watch": "rollup -c --bundleConfigAsCjs --watch",
    "build:clean": "rm -rf dist",
    "build:files": "rollup -c --bundleConfigAsCjs",
    "build": "npm run build:clean && npm run build:files",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "author": "AxisTaylor, LLC <support@axistaylor.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxisTaylor/nextpress.git"
  }
}
