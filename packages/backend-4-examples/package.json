{
  "name": "backend-4-examples",
  "private": true,
  "description": "",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@wordpress/api-fetch": "^7.45.0",
    "@wordpress/interactivity": "^6.45.0",
    "@wordpress/scripts": "^32.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.2.4",
    "ts-loader": "^9.5.7",
    "tsconfig-paths-webpack-plugin": "^4.2.0"
  },
  "scripts": {
    "start": "npm-run-all --sequential postinstall update-plugins build-images docker",
    "start:detached": "npm-run-all --sequential postinstall update-plugins build-images docker:down docker:detached",
    "docker": "docker compose up",
    "docker:detached": "docker compose up -d",
    "docker:down": "docker compose down -v --remove-orphans",
    "update-plugins": "composer update",
    "build-images": "docker compose build",
    "postinstall": "composer install",
    "save-db": "docker exec wp-backend-db /usr/bin/mysqldump -u root -pnot-so-secure wordpress > ./import/dev-backup-$(date +%Y%m%d%H%M%S).sql",
    "build:plugin": "rm -rf web/app/plugins/complex-blocks/dist && wp-scripts build",
    "build:theme": "postcss web/app/themes/custom-block-theme/src/style.css -o web/app/themes/custom-block-theme/style.css && postcss web/app/themes/custom-block-theme/src/editor.css -o web/app/themes/custom-block-theme/editor.css && node prepend-header.js",
    "build": "run-s build:*"
  },
  "keywords": [],
  "author": "AxisTaylor, LLC <support@axistaylor.com>"
}
